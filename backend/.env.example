# Server Configuration
PORT=8000
NODE_ENV=development

# MongoDB Connection
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net

# JWT Secrets (Generate secure random strings)
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_here
REFRESH_TOKEN_SECRET=your_jwt_refresh_token_secret_here

# Cloudinary Configuration (For media storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Admin Configuration
ADMIN_EMAIL=admin@example.com

# CORS Configuration (Comma-separated URLs for allowed frontends)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
